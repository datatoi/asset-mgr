rules_version = '2';
// Data model: subscriptions own groups and all tenant documents. users contain
// subscriptionId/groups (server-managed), and a bounded editable profile.
// Catalog parents, comments, history and transfer states are validated by
// callable functions. No client document writes are accepted, including create.
// Subscription-wide member/catalog reads are intentional (see CLAUDE.md).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function inSubscription(data) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn() && data.subscriptionId is string &&
        user.subscriptionId == data.subscriptionId;
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || inSubscription(resource.data));
      allow write: if false;
    }
    match /subscriptions/{subId} {
      allow read: if signedIn() &&
        (resource.data.ownerUserId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionId == subId);
      allow write: if false;
    }
    match /groups/{id} {
      allow read: if signedIn() && inSubscription(resource.data);
      allow write: if false;
    }
    match /categories/{id} {
      allow read: if signedIn() && inSubscription(resource.data);
      allow write: if false;
    }
    match /products/{id} {
      allow read: if signedIn() && inSubscription(resource.data);
      allow write: if false;
    }
    match /kits/{id} {
      allow read: if signedIn() && inSubscription(resource.data);
      allow write: if false;
    }
    match /items/{itemId} {
      allow read: if signedIn() && inSubscription(resource.data);
      allow write: if false;
      match /comments/{id} {
        allow read: if signedIn() && inSubscription(
          get(/databases/$(database)/documents/items/$(itemId)).data);
        allow write: if false;
      }
      match /holderHistory/{id} {
        allow read: if signedIn() && inSubscription(
          get(/databases/$(database)/documents/items/$(itemId)).data);
        allow write: if false;
      }
    }
    match /transfers/{id} {
      allow read: if signedIn() && inSubscription(resource.data);
      allow write: if false;
    }
  }
}
