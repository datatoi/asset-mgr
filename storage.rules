rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function user() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function inSubscription(subId) {
      return signedIn() && user().subscriptionId == subId;
    }
    function groupAdmin(subId, groupId) {
      let group = firestore.get(/databases/(default)/documents/groups/$(groupId)).data;
      return inSubscription(subId) && group.subscriptionId == subId &&
        (group.get('subscriptionOwnerId', '') == request.auth.uid ||
        user().groups.get(groupId, 'none') in ['admin', 'superadmin']);
    }
    function validImage() {
      return request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
    match /avatars/{uid}/{imageId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && validImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /subscriptions/{subId}/groups/{groupId}/{kind}/{imageId} {
      allow read: if inSubscription(subId) && kind in ['items', 'products'];
      allow create, update: if kind in ['items', 'products'] &&
        groupAdmin(subId, groupId) && validImage();
      allow delete: if kind in ['items', 'products'] && groupAdmin(subId, groupId);
    }
    // Existing authenticated image URLs keep working. Legacy paths are read-only.
    match /products/{imageId} { allow read: if signedIn(); allow write: if false; }
    match /items/{imageId} { allow read: if signedIn(); allow write: if false; }
  }
}
