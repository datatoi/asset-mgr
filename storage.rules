rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      // Note: storage rules can't easily fetch from firestore across projects without specific setup,
      // but in Firebase v9+ they can if it's the same project.
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAnyAdmin() {
      let userData = getUserData();
      return userData.groups.values().hasAny(['admin', 'superadmin']);
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /types/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAnyAdmin();
    }

    match /items/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAnyAdmin();
    }
  }
}
